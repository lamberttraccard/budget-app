APP_NAME=budget-app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production (Laravel Cloud): https://budget.lamberttraccard.dev
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=budget_app
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Nightwatch Monitoring
# On Laravel Cloud: connect via dashboard, env vars are auto-injected
# Locally: keep NIGHTWATCH_ENABLED=false (no agent process needed)
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=1
NIGHTWATCH_COMMAND_SAMPLE_RATE=1
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1

# AI Categorization (Laravel AI SDK / Gemini)
# Required for Story 2.4+ (AI auto-categorization)
GEMINI_API_KEY=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# LARAVEL CLOUD PRODUCTION SETTINGS
# =============================================================================
# Production is the "main" environment of the Laravel Cloud app "budget-app".
# These values live in the Laravel Cloud dashboard, NOT in this file; see
# AGENTS.md for the full deployment description.
#
# Environment variables set on the environment:
#   APP_KEY, GEMINI_API_KEY
# Injected by Laravel Cloud:
#   APP_ENV=production, APP_DEBUG=false, APP_URL, DB_* (Neon Postgres),
#   QUEUE_CONNECTION=cloud (managed queue), NIGHTWATCH_*,
#   LOG_STACK=laravel-cloud-socket,nightwatch
#
# Build command:
#   composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
#   npm install -g bun
#   bun install
#   bun run build
#
# Deploy command:
#   php artisan migrate --force
#
# First deploy only:
#   php artisan db:seed --class=CategorySeeder --force
# =============================================================================
